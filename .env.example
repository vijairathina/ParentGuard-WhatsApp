# ParentGuard WhatsApp Configuration
# Port for Web Application
FLASK_PORT=5003
FLASK_DEBUG=false
SECRET_KEY=replace_with_a_secure_random_key

# Google Gemini AI Safety & Content Moderation API Key
# Obtain free at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Default Gemini Model (e.g. gemini-1.5-flash or gemini-2.0-flash)
GEMINI_MODEL=gemini-1.5-flash
